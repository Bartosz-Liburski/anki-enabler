---
import Layout from "@/layouts/Layout.astro";
import AddSourceForm from "@/components/sources/AddSourceForm";
import LanguagePairForm from "@/components/sources/LanguagePairForm";
import { createClient } from "@/lib/supabase";
import { languageLabel } from "@/lib/languages";
import {
  isExportErrorCode,
  SOURCE_SUCCESS_CODE,
  SOURCE_SUCCESS_MESSAGE,
  sourceErrorMessage,
} from "@/lib/source-errors";
import { isValidPair } from "@/lib/source-pair";

const { user } = Astro.locals;

// The learning direction lives in the URL: LanguagePairForm GETs here with these exact field
// names, and POST /api/sources echoes them back on every redirect. That is what keeps one pair
// open across many uploads — and makes the pair bookmarkable.
//
// Persistence across tab closes is the middleware's job: it mirrors the pair into a cookie and
// redirects a bare /dashboard visit to the canonical pair URL. So this page reads only the URL.
const learnedLanguage = Astro.url.searchParams.get("learned_language") ?? "";
const knownLanguage = Astro.url.searchParams.get("known_language") ?? "";
const pairReady = isValidPair(learnedLanguage, knownLanguage);

// Export failures get their own banner rather than riding the shared `error` into AddSourceForm's
// serverError prop below — an export problem rendered against the upload form reads as if the
// upload had failed. Every other code keeps flowing exactly as it did before. The codes come from
// source-errors.ts rather than being re-spelled here, so renaming one cannot silently switch the
// split off while still type-checking.
const errorCode = Astro.url.searchParams.get("error");
const errorMessage = sourceErrorMessage(errorCode);
const isExportError = isExportErrorCode(errorCode);
const exportError = isExportError ? errorMessage : null;
const error = isExportError ? null : errorMessage;
const success = Astro.url.searchParams.get("success") === SOURCE_SUCCESS_CODE ? SOURCE_SUCCESS_MESSAGE : null;

// Gates the account-wide export link (S-03). A head-only count, scoped to the user by RLS — the
// dashboard needs the number, not the rows.
//
// A failed count must NOT hide the feature. Treating the error as zero would make the whole export
// section vanish for a user with hundreds of kept cards, with nothing on the page to explain it.
// The link is offered anyway and the count omitted from the copy; the route carries its own
// `export-empty` guard, so an optimistic link costs at worst one redirect with a banner.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const { count, error: countError } = supabase
  ? await supabase.from("flashcards").select("id", { count: "exact", head: true }).eq("discarded", false)
  : { count: 0, error: null };
const countFailed = countError !== null;
const keptCount = count ?? 0;
const canExport = countFailed || keptCount > 0;
---

<Layout title="Dashboard">
  <div class="bg-cosmic flex min-h-screen items-center justify-center p-4">
    <div
      class="w-full max-w-md rounded-2xl border border-white/10 bg-white/10 p-8 text-center text-white backdrop-blur-xl"
    >
      <h1 class="mb-4 bg-gradient-to-r from-blue-200 to-purple-200 bg-clip-text text-3xl font-bold text-transparent">
        Dashboard
      </h1>
      <p class="text-blue-100/80">
        Welcome, <span class="font-semibold text-white">{user?.email}</span>
      </p>

      {
        success && (
          <p class="mt-6 flex items-center gap-2 rounded-lg border border-emerald-500/30 bg-emerald-900/30 px-3 py-2 text-left text-sm text-emerald-200">
            <svg
              class="size-4 shrink-0"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21.801 10A10 10 0 1 1 17 3.335" />
              <path d="m9 11 3 3L22 4" />
            </svg>
            {success}
          </p>
        )
      }

      <div class="mt-6 border-t border-white/10 pt-6">
        {
          pairReady ? (
            <>
              <div class="mb-4 flex items-center justify-between gap-3">
                <div class="text-left">
                  <p class="text-xs tracking-wide text-blue-100/50 uppercase">Learning direction</p>
                  <p class="font-semibold">
                    {languageLabel(learnedLanguage)} → {languageLabel(knownLanguage)}
                  </p>
                </div>
                <a
                  href="/dashboard?pair=change"
                  class="rounded-lg border border-white/20 bg-white/10 px-3 py-1.5 text-xs transition-colors hover:bg-white/20"
                >
                  Change
                </a>
              </div>
              <AddSourceForm
                learnedLanguage={learnedLanguage}
                knownLanguage={knownLanguage}
                serverError={error}
                client:load
              />
              <p class="mt-3 text-left text-xs text-blue-100/50">
                Add as many screenshots to this pair as you like — it stays selected after each one.
              </p>
            </>
          ) : (
            <>
              <h2 class="mb-1 text-left text-lg font-semibold">Pick a language pair</h2>
              <p class="mb-4 text-left text-sm text-blue-100/60">
                Set the translation direction once, then add screenshots to it.
              </p>
              <LanguagePairForm learnedLanguage={learnedLanguage} knownLanguage={knownLanguage} client:load />
              {error && (
                <p class="mt-4 flex items-center gap-2 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-left text-sm text-red-300">
                  {error}
                </p>
              )}
            </>
          )
        }
      </div>

      {
        (canExport || exportError) && (
          <div class="mt-6 border-t border-white/10 pt-6 text-left">
            <h2 class="text-lg font-semibold">Export to Anki</h2>

            {exportError && (
              <p class="mt-3 rounded-lg border border-red-500/30 bg-red-900/30 px-3 py-2 text-sm text-red-300">
                {exportError}
              </p>
            )}

            {canExport && (
              <>
                <p class="mt-1 text-sm text-blue-100/60">
                  Downloads {countFailed ? "the cards" : keptCount === 1 ? "the 1 card" : `all ${keptCount} cards`}{" "}
                  you've kept across every source as one CSV. Each row is tagged with its own learning direction, so you
                  can split them by tag in Anki.
                </p>
                <a
                  href="/api/export.csv"
                  class="mt-3 inline-block rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
                >
                  Download CSV
                </a>
              </>
            )}
          </div>
        )
      }

      <div class="mt-6 flex items-center justify-center gap-3">
        <a
          href="/"
          class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
        >
          Leave dashboard
        </a>
        <form method="POST" action="/api/auth/signout">
          <button
            type="submit"
            class="rounded-lg border border-white/20 bg-white/10 px-4 py-2 text-sm transition-colors hover:bg-white/20"
          >
            Sign out
          </button>
        </form>
      </div>
    </div>
  </div>
</Layout>
